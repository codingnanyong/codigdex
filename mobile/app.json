{
  "expo": {
    "name": "Codigdex",
    "slug": "codigdex",
    "version": "1.0.1",
    "orientation": "default",
    "scheme": "codigdex",
    "userInterfaceStyle": "dark",
    "plugins": [
      ["expo-build-properties", { "ios": { "enableSceneSupport": true } }]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.codingnanyong.codigdex",
      "requireFullScreen": true
    },
    "android": {
      "package": "com.codingnanyong.codigdex"
    }
  }
}
