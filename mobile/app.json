{
  "expo": {
    "name": "Codigdex",
    "slug": "codigdex",
    "icon": "../packages/game-assets/files/icons/codigdex-main-icon.png",
    "version": "1.0.1",
    "orientation": "default",
    "scheme": "codigdex",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-secure-store",
      ["expo-audio", { "microphonePermission": false, "recordAudioAndroid": false, "enableBackgroundPlayback": false, "enableBackgroundRecording": false }],
      ["expo-build-properties", { "ios": { "enableSceneSupport": true } }]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.codingnanyong.codigdex",
      "requireFullScreen": true
    },
    "android": {
      "package": "com.codingnanyong.codigdex"
    }
  }
}
